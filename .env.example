# Copy to .env and fill in. Never commit .env.
# ParcelPilot AI Support Agent — environment configuration.

# --- LLM provider (GENERATION only; embeddings are always LOCAL fastembed) ---
# Which provider the agent loop uses. Both live behind src/llm/client.py.
#   groq   = Groq (gpt-oss-120b: fast, clean tool calling — empirically reliable)
#   gemini = Google Gemini (3.x flash is a thinking model; freer tier but we saw
#            503/429 under load) — good automatic fallback
LLM_PROVIDER=groq

# Optional automatic fallback if the primary provider errors / rate-limits.
# Leave blank to disable. Handy during the live demo.
LLM_FALLBACK_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
# Newest stable Flash with tool calling (verify current ID at ai.google.dev/models)
GEMINI_MODEL=gemini-3.7-flash

# --- Groq (inference-only; NOTE: Groq has NO embeddings endpoint) ---
GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated 2026-06-17; use gpt-oss for tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings: ALWAYS local, no API. Here for reference only. ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
